<Window x:Class="NtpTool.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置"
        Width="860" Height="640"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text"
        Foreground="{StaticResource PrimaryTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Win11 导航条目 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="root" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#E8F1FB"/>
                                <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页内分区标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,18,0,10"/>
        </Style>

        <!-- 设置字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="150"/>
        </Style>

        <!-- Win11 卡片容器 -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== 标题栏 ======== -->
            <Grid Grid.Row="0" Background="#F2F2F2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AppAccentBrush}">
                        <TextBlock Text="N" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="NTP TimeSync Tool" FontSize="10.5"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        FontSize="10" Width="40" Height="32" Margin="0,0,16,0" Padding="0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AppAccentBrush}"/>
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ======== 主体：左导航 + 右内容 ======== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0"
                        Padding="10,10">
                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent" SelectedIndex="0"
                             SelectionChanged="OnNavSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="客户端"/>
                        <ListBoxItem Content="服务端"/>
                        <ListBoxItem Content="日志"/>
                    </ListBox>
                </Border>

                <!-- 右侧内容 -->
                <Grid Grid.Column="1" Margin="8">
                    <!-- 客户端 -->
                    <ScrollViewer x:Name="ViewClient" VerticalScrollBarVisibility="Auto" Margin="4">
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="客户端" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="配置 NTP 客户端的上游服务器与自动同步行为"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="自动同步" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="启用自动同步" IsChecked="{Binding Edit.Client.EnableAutoSync}" Margin="0,0,0,8"/>
                                    <CheckBox Content="启动时执行一次" IsChecked="{Binding Edit.Client.RunOnceOnStart}" Margin="0,0,0,8"/>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="同步周期（分钟）" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/><TextBox Text="{Binding Edit.Client.SyncIntervalMinutes}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="超时（ms）" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/><TextBox Text="{Binding Edit.Client.TimeoutMs}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="失败重试次数" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/><TextBox Text="{Binding Edit.Client.RetryCount}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,6"><TextBlock Text="重试间隔（ms）" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/><TextBox Text="{Binding Edit.Client.RetryIntervalMs}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="系统时间修正" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="同步后自动修正系统时间" IsChecked="{Binding Edit.Client.ApplySystemTime}" Margin="0,0,0,8"/>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="自动修正阈值（ms）" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/><TextBox Text="{Binding Edit.Client.AutoApplyThresholdMs}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,6"><TextBlock Text="最大允许偏差（ms）" Style="{StaticResource FieldLabel}" DockPanel.Dock="Left"/><TextBox Text="{Binding Edit.Client.MaxAllowedOffsetMs}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock Text="上游服务器" FontSize="13" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <Button Content="添加" Command="{Binding AddServerCommand}" Padding="12,5" DockPanel.Dock="Right" MinWidth="56"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                             Height="120" Margin="0,10,0,4" BorderBrush="{StaticResource CardBorderBrush}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Margin" Value="0,1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#E8F1FB"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Enabled}" IsHitTestVisible="False" Margin="0,0,8,0" ToolTip="启用" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Host}" FontWeight="SemiBold" VerticalAlignment="Center" Width="180" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Port, StringFormat=:{0}}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Width="70"/>
                                                    <Border Padding="6,1" CornerRadius="6" Background="#F0F0F0">
                                                        <TextBlock Text="{Binding Priority, StringFormat=优先级 {0}}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="编辑所选服务器" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,8"/>
                                    <DockPanel Margin="0,0,0,8"><TextBlock Text="主机 / IP" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedServer.Host, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                    <DockPanel Margin="0,0,0,8"><TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedServer.Port, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,0,0,8"><TextBlock Text="优先级" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedServer.Priority, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,0,0,8"><TextBlock Text="备注" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedServer.Remark, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                    <CheckBox Content="启用该服务器" IsChecked="{Binding SelectedServer.Enabled}" Margin="0,2,0,14"/>
                                    <Button Content="删除选中服务器" Command="{Binding RemoveServerCommand}" Padding="10,5" Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 服务端 -->
                    <ScrollViewer x:Name="ViewServer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="4">
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="服务端" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="配置 NTP 服务端的监听地址与访问控制"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="监听" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="启用 NTP Server" IsChecked="{Binding Edit.Server.EnableServer}" Margin="0,0,0,8"/>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="监听地址" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Server.ListenAddress}" Width="180" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="监听端口" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Server.Port}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="Stratum" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Server.Stratum}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="Reference ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Server.ReferenceId}" Width="180" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,6"><TextBlock Text="每 IP 每分钟限流" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Server.RateLimitPerMinute}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="访问控制" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="允许所有客户端" IsChecked="{Binding Edit.Server.AllowAllClients}" Margin="0,0,0,8"/>
                                    <CheckBox Content="记录请求日志" IsChecked="{Binding Edit.Server.LogRequests}" Margin="0,0,0,10"/>
                                    <TextBlock Text="访问白名单（CIDR/IP）" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,8"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBox Text="{Binding NewNetwork, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                        <Button Content="添加" Command="{Binding AddNetworkCommand}" Padding="12,5" MinWidth="56"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding AllowedNetworks}" SelectedItem="{Binding SelectedNetwork}"
                                             Height="90" BorderBrush="{StaticResource CardBorderBrush}" FontSize="12" Margin="0,0,0,6"/>
                                    <Button Content="删除选中条目" Command="{Binding RemoveNetworkCommand}" Padding="10,5"
                                            Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 日志 -->
                    <ScrollViewer x:Name="ViewLog" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="4">
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="日志" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="配置日志级别与文件管理策略"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="日志输出" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="日志级别" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding Edit.Log.Level}" SelectedValuePath="Content"
                                                  Width="160" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Trace"/>
                                            <ComboBoxItem Content="Debug"/>
                                            <ComboBoxItem Content="Information"/>
                                            <ComboBoxItem Content="Warning"/>
                                            <ComboBoxItem Content="Error"/>
                                            <ComboBoxItem Content="Fatal"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="日志目录" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Log.Directory}" Width="280" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="单文件大小（MB）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Log.MaxFileSizeMb}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <DockPanel Margin="0,10,0,0"><TextBlock Text="保留天数" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Edit.Log.RetentionDays}" Width="120" HorizontalAlignment="Left"/></DockPanel>
                                    <CheckBox Content="显示 UDP 详细日志" IsChecked="{Binding Edit.Log.LogUdpDetails}" Margin="0,10,0,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ======== 底部操作区 ======== -->
            <Border Grid.Row="2" Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="恢复默认" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="14,7"/>
                    <Button Content="取消" Click="OnCancelClick" Margin="0,0,8,0" Padding="14,7" IsCancel="True"/>
                    <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="20,7" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>