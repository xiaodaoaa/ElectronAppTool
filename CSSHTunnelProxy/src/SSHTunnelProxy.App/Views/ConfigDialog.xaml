<Window x:Class="SSHTunnelProxy.App.Views.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SSHTunnelProxy.Core.Models;assembly=SSHTunnelProxy.Core"
        Title="编辑 SSH 服务器配置"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowRoot"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（拖拽区） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="编辑 SSH 服务器配置" FontSize="15" FontWeight="SemiBold"
                           Margin="18,14,0,14" />
                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click"
                        Style="{StaticResource SubtleButtonStyle}" Width="40" Height="34"
                        Margin="0,6,8,6" VerticalAlignment="Center" />
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,0,18,0">

                    <!-- 基本信息 -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="基本信息" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="配置名称" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Name}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- SSH 服务器 -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SSH 服务器" Style="{StaticResource CardTitleStyle}" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="主机地址" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="端口" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Host}" Margin="0,4,6,10" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Margin="0,4,0,10" />
                            </Grid>
                            <TextBlock Text="用户名" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Username}" Margin="0,4,0,12" />
                            <TextBlock Text="认证方式" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                <RadioButton Content="密码" GroupName="auth" IsChecked="{Binding IsPasswordAuth}" Margin="0,0,16,0" />
                                <RadioButton Content="私钥" GroupName="auth" IsChecked="{Binding IsPrivateKeyAuth}" Margin="0,0,16,0" />
                                <RadioButton Content="键盘交互" GroupName="auth" IsChecked="{Binding IsKeyboardAuth}" />
                            </StackPanel>
                            <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}"
                                       Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="私钥路径" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"
                                       Visibility="{Binding IsPrivateKeyVisible, Converter={StaticResource BoolToVis}}" />
                            <Grid Visibility="{Binding IsPrivateKeyVisible, Converter={StaticResource BoolToVis}}"
                                  Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath}" Margin="0,0,6,0" />
                                <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseKeyCommand}" />
                            </Grid>
                            <PasswordBox x:Name="PassphraseBox" Margin="0,8,0,0" ToolTip="私钥 Passphrase（可选）"
                                         Visibility="{Binding IsPrivateKeyVisible, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- 本地代理 -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="本地代理" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="监听地址" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ListenAddress}" Margin="0,4,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="SOCKS5 端口" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding Socks5Port}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="HTTP 端口" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding HttpPort}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 高级 -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="高级" Style="{StaticResource CardTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="连接超时(秒)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ConnectTimeoutSec}" Margin="0,4,0,10" />
                                    <TextBlock Text="保活间隔(秒)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding KeepAliveIntervalSec}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="最大重连次数(-1无限)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding MaxReconnectAttempts}" Margin="0,4,0,10" />
                                    <TextBlock Text="重连间隔(秒)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ReconnectDelaySec}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8" Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource StandardButtonStyle}" Margin="0,0,10,0" Padding="18,7" />
                    <Button Content="保存" Command="{Binding ValidateAndConfirmCommand}" Style="{StaticResource AccentButtonStyle}" Padding="18,7" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
