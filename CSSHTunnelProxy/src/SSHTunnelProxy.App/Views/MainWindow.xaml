<Window x:Class="SSHTunnelProxy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SSHTunnelProxy.App.ViewModels"
        xmlns:conv="clr-namespace:SSHTunnelProxy.App.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="SSHTunnelProxy"
        Icon="/Assets/app.ico"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:TunnelStateToTextConverter x:Key="StateToText" />
        <conv:TunnelStateToBrushConverter x:Key="StateToBrush" />
        <conv:BytesToTextConverter x:Key="BytesToText" />
        <conv:SpeedToTextConverter x:Key="SpeedToText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 内联卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 导航项模板：胶囊选中 + 左侧强调色竖条 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="12,8">
                                <ContentPresenter x:Name="Content"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch" />
                            </Border>
                            <!-- 左侧强调色竖条 -->
                            <Border x:Name="Indicator" Width="3" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Margin="0,6"
                                    Background="{DynamicResource AccentBrush}"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日志页模板 -->
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="↻ 刷新" Command="{Binding RefreshCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="⬇ 导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource StandardButtonStyle}" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <!-- 启用 UI 虚拟化：仅渲染可视区的行，日志量大时避免一次性创建数万行控件而卡顿。
                         ScrollUnit=Pixel 保证按像素滚动而非按项，配合固定 RowHeight 提升滚动性能。 -->
                    <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="32" AlternatingRowBackground="Transparent"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150" />
                            <DataGridTextColumn Header="隧道" Binding="{Binding TunnelName}" Width="1*" />
                            <DataGridTextColumn Header="客户端" Binding="{Binding ClientEndpoint}" Width="1.2*" />
                            <DataGridTextColumn Header="目标" Binding="{Binding TargetEndpoint}" Width="1.2*" />
                            <DataGridTextColumn Header="上传" Binding="{Binding BytesSent, Converter={StaticResource BytesToText}}" Width="80" />
                            <DataGridTextColumn Header="下载" Binding="{Binding BytesReceived, Converter={StaticResource BytesToText}}" Width="80" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 设置页模板 -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="应用行为" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,0" FontWeight="SemiBold" />
                            <CheckBox Content="关闭时最小化到托盘" IsChecked="{Binding CloseToTray}" Margin="0,10,0,0" />
                            <CheckBox Content="最小化到托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,8,0,0" />
                            <CheckBox Content="启动后最小化到托盘" IsChecked="{Binding StartMinimizedToTray}" Margin="0,8,0,0" />
                            <CheckBox Content="开机自启" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0" />
                            <TextBlock Text="日志保留天数" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,16,0,0" />
                            <TextBox Text="{Binding LogRetentionDays}" HorizontalAlignment="Left" Width="200" Margin="0,4,0,0" />
                            <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0" />
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <!-- ============ 主布局：导航栏 + 内容区 ============ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,20,20,24">
                    <TextBlock Text="SSHTunnelProxy" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <RadioButton GroupName="nav" Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavPage.Tunnels}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛰" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="隧道" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItemStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavPage.Logs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="日志" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" Style="{StaticResource NavItemStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavPage.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Height="1" Background="{DynamicResource DividerBrush}" Margin="16,0" />
                <StackPanel Grid.Row="2" Margin="20,14,20,20">
                    <TextBlock Text="已连接隧道" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding ConnectedCountText}" FontSize="13" Margin="0,2,0,0"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1" Margin="28,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 + 状态 -->
            <Grid Grid.Row="0" Margin="0,0,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="PageTitleText" Text="隧道" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
            </Grid>

            <!-- 内容切换：隧道页 / 日志页 / 设置页 -->
            <Grid Grid.Row="1">
                <!-- 隧道页 -->
                <Grid Visibility="{Binding ShowTunnelPage, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="＋ 新建" Command="{Binding NewTunnelCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="▶ 连接" Command="{Binding SelectedTunnel.StartCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="■ 断开" Command="{Binding SelectedTunnel.StopCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="⟳ 重连" Command="{Binding SelectedTunnel.RestartCommand}" Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0" />

                        <Separator Margin="4,0,8,0" />

                        <Button Content="✎ 编辑" Command="{Binding EditTunnelCommand}" CommandParameter="{Binding SelectedTunnel}"
                                Style="{StaticResource StandardButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="🗑 删除" Command="{Binding DeleteTunnelCommand}" CommandParameter="{Binding SelectedTunnel}"
                                Style="{StaticResource StandardButtonStyle}" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>

                    <!-- 隧道列表：卡片式 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Tunnels}"
                             SelectedItem="{Binding SelectedTunnel}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="0,0,16,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Card" Style="{StaticResource CardStyle}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,14,0"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                             VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="    " />
                                            <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ServerInfo}" Margin="0,3,0,0"
                                                   FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" />
                                        <TextBlock Text="{Binding PortsInfo}" Margin="0,1,0,0"
                                                   FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" />
                                        <TextBlock Text="{Binding StatusMessage}" Margin="0,2,0,0"
                                                   FontSize="12" Foreground="{DynamicResource MutedStrongForegroundBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 详情面板：分组卡片 -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,4,16,16"
                            DataContext="{Binding SelectedTunnel}">
                        <StackPanel>
                            <TextBlock Text="隧道详情" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="状态" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding State, Converter={StaticResource StateToText}}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="上传" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1">
                                    <Run Text="{Binding TotalSent, Converter={StaticResource BytesToText}}" />
                                    <Run Text=" (" /><Run Text="{Binding UploadSpeed, Converter={StaticResource SpeedToText}}" /><Run Text=")" />
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="下载" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1">
                                    <Run Text="{Binding TotalReceived, Converter={StaticResource BytesToText}}" />
                                    <Run Text=" (" /><Run Text="{Binding DownloadSpeed, Converter={StaticResource SpeedToText}}" /><Run Text=")" />
                                </TextBlock>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="运行时长" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UptimeText}" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="监听" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PortsInfo}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 日志 / 设置页 -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentPageContent}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
