<Application x:Class="SSHTunnelProxy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SSHTunnelProxy.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============================================================
                 Win11 Fluent 浅色配色（唯一默认主题）
                 AccentBrush/AccentColor 由 AccentColorProvider 在运行时注入覆盖。
                 ============================================================ -->

            <!-- 语义色 -->
            <Color x:Key="SuccessColor">#0F7B0F</Color>
            <Color x:Key="DangerColor">#C42B1C</Color>
            <Color x:Key="WarningColor">#9D5D00</Color>

            <!-- 基础表面 -->
            <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
            <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="SidebarBackgroundColor">#F3F3F3</Color>
            <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
            <Color x:Key="HoverOverlayColor">#0D000000</Color>     <!-- 悬停覆盖层(黑色低透明度) -->
            <Color x:Key="PressedOverlayColor">#19000000</Color>   <!-- 按压覆盖层 -->
            <Color x:Key="TextBoxBackgroundColor">#FFFFFF</Color>
            <Color x:Key="BoxFillColor">#FFFFFF</Color>

            <!-- 边框与分隔 -->
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="SubtleBorderColor">#EDEDED</Color>
            <Color x:Key="DividerColor">#E0E0E0</Color>

            <!-- 文字 -->
            <Color x:Key="ForegroundColor">#1A1A1A</Color>
            <Color x:Key="MutedForegroundColor">#6B6B6B</Color>
            <Color x:Key="MutedStrongForegroundColor">#3C3C3C</Color>
            <Color x:Key="DisabledForegroundColor">#A0A0A0</Color>

            <!-- 强调色(占位，运行时可被注入覆盖) -->
            <Color x:Key="AccentColor">#0078D4</Color>
            <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
            <Color x:Key="AccentHoverColor">#006CC1</Color>
            <Color x:Key="AccentPressedColor">#0060AB</Color>
            <Color x:Key="AccentSubtleColor">#F0F4F9</Color>

            <!-- 按钮 -->
            <Color x:Key="ButtonBackgroundColor">#FFFFFF</Color>
            <Color x:Key="ButtonHoverColor">#F5F5F5</Color>
            <Color x:Key="ButtonPressedColor">#E5E5E5</Color>
            <Color x:Key="ButtonBorderColor">#C7C7C7</Color>

            <!-- 选中态 -->
            <Color x:Key="SelectionBackgroundColor">#E5EFFB</Color>
            <Color x:Key="SelectionHoverColor">#DCEAFA</Color>

            <!-- 滚动条 -->
            <Color x:Key="ScrollBarThumbColor">#C2C2C2</Color>
            <Color x:Key="ScrollBarThumbHoverColor">#9A9A9A</Color>
            <Color x:Key="ScrollBarTrackColor">#FFFFFF</Color>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
            <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
            <SolidColorBrush x:Key="PressedOverlayBrush" Color="{StaticResource PressedOverlayColor}" />
            <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="{StaticResource TextBoxBackgroundColor}" />
            <SolidColorBrush x:Key="BoxFillBrush" Color="{StaticResource BoxFillColor}" />

            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

            <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" />
            <SolidColorBrush x:Key="MutedStrongForegroundBrush" Color="{StaticResource MutedStrongForegroundColor}" />
            <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
            <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ButtonBorderColor}" />

            <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}" />
            <SolidColorBrush x:Key="SelectionHoverBrush" Color="{StaticResource SelectionHoverColor}" />

            <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
            <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />
            <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ScrollBarTrackColor}" />

            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
